# --- Server ---
# Port the API listens on
PORT=3000

# --- Supabase ---
# Found in your Supabase project: Project Settings -> API
# The API URL looks like: https://xxxxxxxxxxxx.supabase.co
# Either the plain names below or their VITE_ equivalents are accepted
# (e.g. VITE_SUPABASE_URL / VITE_SUPABASE_SERVICEROLE_KEY).
SUPABASE_URL=

# Service role key (server-side only, never expose it in the mobile/web app)
SUPABASE_SERVICE_ROLE_KEY=